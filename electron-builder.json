{
  "appId": "com.djworkstation.app",
  "productName": "DJ Workstation & Music Studio",
  "copyright": "Copyright © 2026",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "DJ Workstation",
    "artifactName": "DJ-Workstation-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "DJ-Workstation-Portable-${version}.${ext}"
  }
}
